def connection_to_scope():
    rm = pyvisa.ResourceManager()
    print(rm.list_resources())
    scope = rm.open_resource(f'TCPIP0::{Scope_IP_Address}::INSTR')
    

    try:
        print(scope.query('*IDN?'))
    except Exception as e:
        print(f"An error occurred: {e}")

    try:
        print(scope.query(':ACQuire:AMODe?'))
        scope.write(':ACQuire:AMODe FAST')
        print(scope.query(':ACQuire:AMODe?'))
    except Exception as e:
        print((f"An error occurred: {e}"))


    try:
        print("Configuring NTP........")
        print(scope.query(':SYSTem:COMMunicate:LAN:TYPE?'))
        scope.write(f':SYSTem:NETwork:IPADdress {Scope_IP_Address}')
        scope.write(f':SYSTem:NETwork:SMASk {Subnet_Mask}')
        scope.write(f':SYSTem:NETwork:GWAY {Gateway}')
        print(scope.query(':SYSTem:DATE?'))
        print(scope.query(':SYSTem:TIME?'))
    except Exception as e:
        print(f"An error occurred: {e}")

    try:
        print("Configuring and forcing NTP synchronization...")
        
        scope.write(f':SYSTem:NTP:SERVer "{NTP_Server_IP_Address}"')
    
        scope.write(':SYSTem:NTP:UPDate')

        scope.write(':SYSTem:NTP:PONSync ON')
        scope.write(':SYSTem:NTP:PERiodic ON')
        scope.write(':SYSTem:NTP:INTeval 60')
    
        print(f"Verified Scope Date: {scope.query(':SYSTem:DATE?').strip()}")
        print(f"Verified Scope Time: {scope.query(':SYSTem:TIME?').strip()}")

    except Exception as e:
        print(f"An error occurred during NTP configuration: {e}")

    try:
        print("Configuring NTP........")
        print(scope.query(':SYSTem:COMMunicate:LAN:TYPE?'))
        scope.write(':SYSTem:COMMunicate:LAN:TYPE DHCP')


    except Exception as e:
        print(f"An error occurred: {e}")


    try:
        print(scope.query('TRIG:MODE?'))
        scope.write(':TRIGger:MODE SINGle')
    except Exception as e:
        print(f"")

    


    scope.close()
    rm.close()







def scope_web():
    url = 'http://10.0.0.155'
    payload = {'button_id': 'submit_value'}

    session = requests.Session()
    response = session.post(url, data=payload)

    print(response.text)












def download_smb_file():
    username = "ShareUser"
    password = ""
    client_name = socket.gethostname()
    server_name = "SIGLENT"
    server_ip = "10.0.0.155"
    print(client_name)
    share_name = "share"
    remote_file_path = "SIGLENT\SDS814X_HD_Binary_C1_1.bin"
    local_file_path = r"C:\Users\Korbi\OneDrive\Desktop\netStorage\temp.bin"


    conn = SMBConnection(username, password, client_name, server_name, use_ntlm_v2=True)
    
    try:
        connected = conn.connect(server_ip, 445)
        if not connected:
            print("Failed to connect to the SMB server.")
            return

        print("Connected successfully. Downloading file...")

        with open(local_file_path, "wb") as local_file:
            conn.retrieveFile(share_name, remote_file_path, local_file)
            
        print(f"File downloaded successfully to {local_file_path}")

    except Exception as e:
        print(f"An error occurred: {e}")
        
    finally:
        conn.close()

download_smb_file()

